#!/bin/sh /etc/rc.common
# duo-ap OTBR: restart the services WDS uplink if the far side stops
# answering. See /usr/sbin/uplink-watchdog.
#
# The ping target is site-specific and has no default; the service doesn't
# start until it's set. The other defaults can be overridden the same way:
#   uci set system.uplink_watchdog=uplink_watchdog
#   uci set system.uplink_watchdog.target='fe80::...'
#   uci commit system; /etc/init.d/uplink-watchdog restart
# Set 'option enabled 0' in that section to turn it off.

START=99
USE_PROCD=1

start_service() {
	local enabled network target interval failures holdoff

	enabled=$(uci -q get system.uplink_watchdog.enabled || echo 1)
	[ "$enabled" = 1 ] || return 0

	network=$(uci -q get system.uplink_watchdog.network || echo services)
	# e.g. the main router's link-local address on the services VLAN
	target=$(uci -q get system.uplink_watchdog.target)
	if [ -z "$target" ]; then
		logger -t uplink-watchdog -p daemon.warn \
			"system.uplink_watchdog.target not set, not starting"
		return 0
	fi
	interval=$(uci -q get system.uplink_watchdog.interval || echo 30)
	failures=$(uci -q get system.uplink_watchdog.failures || echo 4)
	holdoff=$(uci -q get system.uplink_watchdog.holdoff || echo 300)

	procd_open_instance
	procd_set_param command /usr/sbin/uplink-watchdog \
		"$network" "$target" "$interval" "$failures" "$holdoff"
	procd_set_param respawn
	procd_close_instance
}
